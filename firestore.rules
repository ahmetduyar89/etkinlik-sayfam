rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function staff() { return signedIn() && profile().active == true && profile().role in ['admin', 'board']; }
    function admin() { return signedIn() && profile().active == true && profile().role == 'admin'; }
    function activeClass(classId) { return exists(/databases/$(database)/documents/classrooms/$(classId)) && get(/databases/$(database)/documents/classrooms/$(classId)).data.archived == false; }
    function classAccess(classId) { return admin() || (staff() && activeClass(classId)); }
    function sharedNotebook(classId, id) { return get(/databases/$(database)/documents/classrooms/$(classId)/notebooks/$(id)).data.get('shared', false) == true; }
    function validSubmission() {
      let d = request.resource.data;
      return d.keys().hasOnly(['activity_id', 'student_name', 'started_at', 'submitted_at', 'answers', 'created_at', 'owner_uid'])
        && d.owner_uid == request.auth.uid && d.activity_id is string && d.activity_id.size() <= 200
        && d.student_name is string && d.student_name.size() > 0 && d.student_name.size() <= 120
        && d.answers is map && d.started_at is string && d.created_at is string
        && (d.submitted_at == null || d.submitted_at is string);
    }
    function ownSubmissionUpdate() {
      return signedIn() && resource.data.owner_uid == request.auth.uid
        && resource.data.submitted_at == null && validSubmission()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'submitted_at']);
    }
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      // Roles can only be provisioned by the trusted Admin SDK setup script.
      allow list, write: if false;
    }
    match /activities/{id} { allow read: if true; allow write: if admin(); }
    match /units/{id} { allow read: if true; allow write: if admin(); }
    match /folders/{id} { allow read, write: if admin(); }
    match /notebooks/{id} {
      allow get: if admin() || resource.data.get('shared', false) == true;
      allow list, write: if admin();
    }
    match /notebook_content/{id} {
      allow get: if admin() || get(/databases/$(database)/documents/notebooks/$(id.split('__c')[0])).data.get('shared', false) == true;
      allow list, write: if admin();
    }
    match /notebook_ops/{id}/ops/{op} {
      allow read: if admin() || get(/databases/$(database)/documents/notebooks/$(id)).data.get('shared', false) == true;
      allow write: if admin();
    }
    match /pdf_files/{id} { allow get: if admin() || resource.data.get('shared', false) == true; allow list, write: if admin(); }
    match /submissions/{id} {
      allow read, delete: if admin();
      allow create: if signedIn() && validSubmission();
      allow update: if ownSubmissionUpdate();
    }
    match /classrooms/{classId} {
      allow read: if admin() || (staff() && resource.data.archived == false);
      allow create, update: if admin() && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.grade_level in ['5','6','7','8','9','10','11','12']
        && request.resource.data.school_year is string && request.resource.data.archived is bool
        && request.resource.data.activity_ids is list && request.resource.data.include_grade_content is bool;
      allow delete: if false;
      match /folders/{id} { allow read, write: if classAccess(classId); }
      match /notebooks/{id} {
        allow get: if classAccess(classId) || resource.data.get('shared', false) == true;
        allow list, write: if classAccess(classId);
      }
      match /notebook_content/{id} {
        allow get: if classAccess(classId) || sharedNotebook(classId, id.split('__c')[0]);
        allow list, write: if classAccess(classId);
      }
      match /notebook_ops/{id}/ops/{op} {
        allow read: if classAccess(classId) || sharedNotebook(classId, id);
        allow write: if classAccess(classId);
      }
      match /activity_work/{id} { allow read, write: if classAccess(classId); }
      match /recent_activities/{id} { allow read, write: if classAccess(classId); }
      match /pdf_files/{id} { allow get: if classAccess(classId) || resource.data.get('shared', false) == true; allow list, write: if classAccess(classId); }
      match /submissions/{id} {
        allow read, delete: if classAccess(classId);
        allow create: if signedIn() && activeClass(classId) && validSubmission();
        allow update: if activeClass(classId) && ownSubmissionUpdate();
      }
    }
    // Existing standalone live chess remains available to anonymous player sessions.
    match /chess_rooms/{id} { allow read: if true; allow write: if signedIn(); }
  }
}
