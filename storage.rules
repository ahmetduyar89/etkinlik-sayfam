rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // PDF dokümanları: Herkese veya oturum açmış kullanıcılara okuma izni,
    // oturum açmış kullanıcı veya öğretmenlere yazma izni
    match /notebooks/pdfs/{pdfId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /activities/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
