rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function userDoc() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function hasUser() {
      return request.auth != null && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function staff() {
      return hasUser() && userDoc().active == true && userDoc().role in ['admin', 'board'];
    }
    function admin() {
      return hasUser() && userDoc().active == true && userDoc().role == 'admin';
    }
    function activeClass(id) {
      return firestore.exists(/databases/(default)/documents/classrooms/$(id)) && firestore.get(/databases/(default)/documents/classrooms/$(id)).data.archived == false;
    }
    function classAccess(id) {
      return admin() || (staff() && activeClass(id));
    }
    function sharedPdf(classId, id) {
      return firestore.exists(/databases/(default)/documents/classrooms/$(classId)/pdf_files/$(id))
        && firestore.get(/databases/(default)/documents/classrooms/$(classId)/pdf_files/$(id)).data.shared == true;
    }
    function sharedRootPdf(id) {
      return firestore.exists(/databases/(default)/documents/pdf_files/$(id))
        && firestore.get(/databases/(default)/documents/pdf_files/$(id)).data.shared == true;
    }
    function pdf() {
      return request.resource.size <= 25 * 1024 * 1024 && request.resource.contentType == 'application/pdf';
    }

    match /activities/{file} { allow read: if true; allow write: if admin(); }
    match /pdfs/{id} {
      allow read: if sharedRootPdf(id) || admin();
      allow create, update: if admin() && pdf();
      allow delete: if admin();
    }
    match /classrooms/{classId}/pdfs/{id} {
      allow read: if sharedPdf(classId, id) || classAccess(classId);
      allow create, update: if classAccess(classId) && pdf();
      allow delete: if classAccess(classId);
    }
  }
}
