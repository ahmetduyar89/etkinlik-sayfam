{
  "name": "etkinlik-sitem",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/export-dna-lesson.mjs && vite build && node scripts/copy-apps.mjs",
    "build:check": "tsc && node scripts/export-dna-lesson.mjs && vite build && node scripts/copy-apps.mjs",
    "export:dna": "node scripts/export-dna-lesson.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:security": "firebase emulators:exec --project demo-atolye-tests --only firestore,auth,storage \"node --test scripts/classrooms/security.test.mjs\"",
    "classrooms:setup": "node scripts/classrooms/provision.mjs",
    "emulators": "firebase emulators:start --project demo-atolye --only firestore,auth,storage",
    "test:classrooms": "firebase emulators:exec --project demo-atolye-tests --only firestore,auth,storage \"node --test scripts/classrooms/*.test.mjs\""
  },
  "dependencies": {
    "@types/three": "^0.185.4",
    "clsx": "^2.1.0",
    "firebase": "^10.8.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.344.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/forms": "^0.5.7",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "fake-indexeddb": "^6.2.2",
    "firebase-admin": "^13.4.0",
    "firebase-tools": "^14.15.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.2.2",
    "vite": "^5.1.4"
  }
}
